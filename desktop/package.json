{
  "name": "anipoex-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "bun ensure-runtime.js && electron .",
    "build:web": "cd .. && bunx expo export -p web",
    "build:runtime": "../android/gradlew -p ../modules/extension-runtime/jvm installDist jlinkRuntime",
    "dist": "bun run build:web && bun run build:runtime && electron-builder --mac",
    "dist:win": "bun run build:web && bun ensure-runtime.js && electron-builder --win"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.anipoex.desktop",
    "productName": "Anipoex",
    "extraMetadata": {
      "productName": "Anipoex"
    },
    "files": [
      "!**/*.test.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "artifactName": "anipoex-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "anipoex-${version}-${arch}-setup.${ext}"
    },
    "extraResources": [
      {
        "from": "../dist",
        "to": "web"
      },
      {
        "from": "../modules/extension-runtime/jvm/build/install/extension-runtime",
        "to": "server"
      },
      {
        "from": "../modules/extension-runtime/jvm/build/jre",
        "to": "jre"
      },
      {
        "from": "../modules/extension-runtime/ios/challenge-banner.html",
        "to": "challenge-banner.html"
      }
    ]
  }
}
